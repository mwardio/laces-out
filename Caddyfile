{
	admin off
	log default {
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
		}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	@imageOptimizer path /_next/image
	respond @imageOptimizer 404

	@backend path /v1/* /health/*
	reverse_proxy @backend api:4000 {
		header_up X-Forwarded-For {client_ip}
	}
	reverse_proxy web:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The two Cloudflare origins are the Web Analytics beacon and nothing else: the script is
		# served from static.cloudflareinsights.com and reports to cloudflareinsights.com. They are
		# listed individually rather than by wildcard so this stays an analytics allowance and does
		# not quietly become a general Cloudflare allowance. Every other directive is unchanged.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
}
