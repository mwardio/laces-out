{
	admin off
	log default {
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace error REDACTED
				replace error_description REDACTED
				replace error_uri REDACTED
			}
		}
	}
}

# The one security-header set. The two snippet arguments are the only difference between
# deployments: args[0] widens script-src, args[1] widens connect-src.
(security-headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'{args[0]}; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'{args[1]}; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
}

# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS picks one of these, so the /privacy disclosure and the CSP flip
# from one flag. Any value other than enabled/disabled names a snippet that does not exist and the
# gateway fails to start.
(analytics-csp-disabled) {
	import security-headers "" ""
}

(analytics-csp-enabled) {
	import security-headers " https://static.cloudflareinsights.com" " https://cloudflareinsights.com"
}

# WWW_REDIRECT=on adds the canonical-host redirect. It requires a hostname SITE_ADDRESS (not :80)
# and DNS that answers for www.; Caddy already redirects HTTP to HTTPS for hostname site addresses.
(www-redirect-off) {
}

(www-redirect-on) {
	www.{$SITE_ADDRESS} {
		redir https://{$SITE_ADDRESS}{uri} permanent
	}
}

import www-redirect-{$WWW_REDIRECT:off}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	@imageOptimizer path /_next/image
	respond @imageOptimizer 404

	@backend path /v1/* /health/*
	reverse_proxy @backend api:4000 {
		header_up X-Forwarded-For {client_ip}
	}
	reverse_proxy web:3000

	# Deferred (>) so the gateway replaces the upstream's `max-age=0, must-revalidate`. The landing
	# page links a content-hashed social image URL, so a day of edge caching is safe; /ios links the
	# un-hashed URL, which is also fine at 24 h.
	@socialImage path /opengraph-image*
	header @socialImage >Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	@crawlerMetadata path /robots.txt /sitemap.xml /manifest.webmanifest
	header @crawlerMetadata >Cache-Control "public, max-age=3600"

	import analytics-csp-{$NEXT_PUBLIC_CLOUDFLARE_ANALYTICS:disabled}
}
