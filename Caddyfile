{
	admin off
	log default {
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace error REDACTED
				replace error_description REDACTED
				replace error_uri REDACTED
			}
		}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	@imageOptimizer path /_next/image
	respond @imageOptimizer 404

	@backend path /v1/* /health/*
	reverse_proxy @backend api:4000 {
		header_up X-Forwarded-For {client_ip}
	}
	reverse_proxy web:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
}
