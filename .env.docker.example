# Browser-visible origin. Rebuild the images after changing this value. It stays canonical for
# every link the API builds: OAuth callback redirects, invitation URLs, and SEO metadata.
PUBLIC_URL=http://localhost:3000
# Optional: additional origins the same gateway serves this deployment on, comma separated. Each
# must be a bare HTTPS origin in production. This only widens which browser origins the API accepts
# and reflects — it never changes which domain a generated link points at.
# ADDITIONAL_WEB_ORIGINS=https://second-domain.example
# Public contact rendered in the landing-page footer, privacy policy, and terms.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to available after Yahoo approves the app and production credentials are configured.
NEXT_PUBLIC_YAHOO_ACCESS_STATUS=pending
SITE_ADDRESS=:80
APP_PORT=3000
HTTPS_PORT=3443

# For public automatic HTTPS, use all four lines below instead:
# PUBLIC_URL=https://laces.example.com
# SITE_ADDRESS=laces.example.com
# APP_PORT=80
# HTTPS_PORT=443

# Use a URL-safe random value, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_PORT=55432

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Generate with: printf 'base64:' && openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=base64:replace-with-32-random-bytes

# Optional included Film Room access for every signed-in member. Keep this server-side.
GEMINI_API_KEY=
MANAGED_AI_DAILY_REQUEST_LIMIT=50
MANAGED_AI_MAX_OUTPUT_TOKENS=2000

# The single reusable code you share with invited friends.
REGISTRATION_INVITE_CODE=replace-with-a-long-memorable-private-code

# Master switch for ESPN live draft ingest, and the emergency kill switch. Leave false until the
# live validation matrix in docs/ESPN_LIVE_DRAFT_SYNC_PLAN.md has passed. Turning it off stops new
# provider observations from mutating a draft; accepted events and manual backup keep working.
ESPN_LIVE_DRAFT_SYNC=false

# Optional web push ("game day alerts"). Leaving all three blank disables the feature cleanly:
# Settings shows a labeled disabled state and the worker sweep no-ops. Generate the pair once with:
#   npx web-push generate-vapid-keys
# Keep the private key server-side; never prefix either key with NEXT_PUBLIC_.
# VAPID_SUBJECT must be a mailto: address or an https: URL a push service can contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

LOG_LEVEL=info

# Yahoo is optional until an application has been approved.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
