NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public-site metadata and provider-review contact. Set both before an internet deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to available after Yahoo approves the app and production credentials are configured.
NEXT_PUBLIC_YAHOO_ACCESS_STATUS=pending
PORT=4000
DATABASE_URL=postgres://fantasy:fantasy@localhost:5432/fantasy
POSTGRES_PORT=5432
# Generate 32 random bytes, encode as base64, and prefix with `base64:`. Never commit it.
CREDENTIAL_ENCRYPTION_KEY=
# Optional server-side Gemini access for every signed-in member. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
MANAGED_AI_DAILY_REQUEST_LIMIT=50
MANAGED_AI_MAX_OUTPUT_TOKENS=2000
# Generate at least 32 random bytes for session/capability key derivation. Never commit it.
SESSION_SECRET=
# Optional: 16-128 characters. Blank disables /register. Use a high-entropy value shared out of band.
REGISTRATION_INVITE_CODE=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:4000/v1/connections/yahoo/callback
# Master switch for ESPN live draft ingest, and the emergency kill switch. Leave false until the
# live validation matrix in docs/ESPN_LIVE_DRAFT_SYNC_PLAN.md has passed. Turning it off stops new
# provider observations from mutating a draft; accepted events and manual backup keep working.
ESPN_LIVE_DRAFT_SYNC=false
LOG_LEVEL=info
