NODE_ENV=development
# WEB_URL is canonical for link-building; ADDITIONAL_WEB_ORIGINS only widens origin acceptance.
WEB_URL=http://localhost:3000
# Optional, comma separated. Extra browser origins the API accepts requests from when one gateway
# serves this deployment on more than one domain. Bare HTTPS origins only in production.
ADDITIONAL_WEB_ORIGINS=
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# "true" makes the browser bundle call /v1 on whichever domain served the page instead of the baked
# NEXT_PUBLIC_API_URL. Leave false for local development, where web and API are on different ports.
NEXT_PUBLIC_API_SAME_ORIGIN=false
# Public-site metadata and provider-review contact. Set both before an internet deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Disclosure switch only. Set enabled only when a hosting layer separately runs Cloudflare Web
# Analytics and its deployment-specific CSP permits the required origin(s).
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS=disabled
# Set to available after Yahoo approves the app and production credentials are configured.
NEXT_PUBLIC_YAHOO_ACCESS_STATUS=pending
PORT=4000
DATABASE_URL=postgres://fantasy:fantasy@localhost:5432/fantasy
POSTGRES_PORT=5432
# Generate 32 random bytes, encode as base64, and prefix with `base64:`. Never commit it.
CREDENTIAL_ENCRYPTION_KEY=
# Optional server-side Gemini access for every signed-in member. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
MANAGED_AI_DAILY_REQUEST_LIMIT=50
MANAGED_AI_MAX_OUTPUT_TOKENS=2000
# Generate at least 32 random bytes for session/capability key derivation. Never commit it.
SESSION_SECRET=
# Optional: 16-128 characters. Blank disables /register. Use a high-entropy value shared out of band.
REGISTRATION_INVITE_CODE=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must be the exact API_URL origin plus this fixed HTTPS callback path (loopback HTTP is dev-only).
YAHOO_REDIRECT_URI=http://localhost:4000/v1/connections/yahoo/callback
# Master switch for ESPN live draft ingest, and the emergency kill switch. Leave false until the
# live validation gate in docs/provider-notes/espn.md has passed. Turning it off stops new provider
# observations from mutating a draft; accepted events and manual backup keep working.
ESPN_LIVE_DRAFT_SYNC=false
ESPN_PUBLIC_DIRECT_SYNC_ENABLED=false
# Optional web push ("game day alerts"). Blank on all three disables the feature cleanly: the API
# reports it unavailable, Settings shows a labeled disabled state, and the worker sweep no-ops.
# Generate the pair once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address or an https: URL the push services can contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
LOG_LEVEL=info
