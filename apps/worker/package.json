{
  "name": "@laces-out/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/worker.js",
    "catalog:refresh": "tsx scripts/catalog-refresh.ts",
    "projections:validate": "tsx scripts/validate-first-party-projections.ts",
    "schedule-edge:validate": "tsx scripts/validate-schedule-edge.ts",
    "ros:validate": "tsx scripts/validate-first-party-ros.ts",
    "ros:validate:release": "bash ../../scripts/run-ros-release-validation.sh",
    "ros:compose": "tsx scripts/compose-first-party-ros.ts",
    "ros:admit": "tsx scripts/admit-first-party-ros.ts",
    "ros:regate": "tsx scripts/regate-first-party-ros.ts",
    "ros:coverage": "tsx scripts/validate-ros-data-coverage.ts"
  },
  "dependencies": {
    "@laces-out/change-events": "*",
    "@laces-out/config": "*",
    "@laces-out/contracts": "*",
    "@laces-out/db": "*",
    "@laces-out/decisions": "*",
    "@laces-out/domain": "*",
    "@laces-out/email": "*",
    "@laces-out/jobs": "*",
    "@laces-out/league-analytics": "*",
    "@laces-out/league-sync": "*",
    "@laces-out/projections": "*",
    "@laces-out/rankings": "*",
    "@laces-out/source-ffc": "*",
    "@laces-out/source-nflverse": "*",
    "@laces-out/source-sleeper": "*",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.4",
    "pg-boss": "^12.5.1",
    "pino": "^9.7.0",
    "web-push": "^3.6.7"
  }
}
